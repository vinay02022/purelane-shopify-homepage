<section class="sec" id="shop" data-scene="3">
  <div class="wrap">
    <div class="panel-head rv">
      {% if section.settings.kicker != blank %}
        <span class="kicker">{{ section.settings.kicker }}</span>
      {% endif %}
      
      {% if section.settings.heading != blank %}
        <h2 class="d2" style="margin-top:12px">{{ section.settings.heading }}</h2>
      {% endif %}
      
      <div class="rule">
        <i></i>
        {% render 'icon-purelane', icon: 'leaf' %}
        <i></i>
      </div>
    </div>

    <div class="shelf">
      {%- assign selected_collection = section.settings.collection | default: collections.all -%}
      {%- assign limit = section.settings.products_to_show | default: 4 -%}

      {% if selected_collection.products.size > 0 %}
        {% for product in selected_collection.products limit: limit %}
          {% render 'card-product-purelane', card_product: product %}
        {% endfor %}
      {% else %}
        {% comment %} Empty state handling for empty collections {% endcomment %}
        <div class="glass" style="grid-column: 1 / -1; padding: 40px; text-align: center;">
          <h3 class="d3" style="margin-bottom: 10px;">No products found</h3>
          <p class="body-s">There are currently no products available in this collection.</p>
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane Product Grid",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Section Kicker",
      "default": "Bestsellers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Loved by 30,000 homes"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Select Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 12,
      "step": 4,
      "default": 4,
      "label": "Products to show"
    }
  ],
  "presets": [
    {
      "name": "Purelane Product Grid"
    }
  ]
}
{% endschema %}
