<section class="sec revband" id="reviews" data-scene="1">
  <div class="wrap">
    <div class="revhead rv">
      {% if section.settings.kicker != blank %}
        <span class="kicker">{{ section.settings.kicker }}</span>
      {% endif %}

      <span class="agg">
        <span class="st" aria-hidden="true">★★★★★</span>
        <b>{{ section.settings.rating_score | default: '4.8' }}</b>
        from {{ section.settings.rating_count | default: '8,000+' }} reviews
      </span>

      <span class="agg">
        Loved by <b>{{ section.settings.homes_count | default: '12 lakh+' }}</b> homes
      </span>
    </div>
  </div>

  <div class="revrail rv" aria-label="Customer reviews marquee">
    <div class="revtrack">
      {% comment %} Primary Loop {% endcomment %}
      {% for block in section.blocks %}
        {% render 'card-review-purelane', block: block %}
      {% else %}
        {% comment %} Default fallback review cards {% endcomment %}
        <article class="glass-2 rcard">
          <div class="st">★★★★★</div>
          <h5>Works like a charm</h5>
          <p>Finally an eco option that cleans as well as the chemical detergent I used for years, and it smells better.</p>
          <div class="who">{% render 'icon-purelane', icon: 'check-simple' %}<b>Anita</b><span>&middot; Laundry detergent</span></div>
        </article>
        <article class="glass-2 rcard">
          <div class="st">★★★★★</div>
          <h5>Best dishwash ever</h5>
          <p>Our old dishwash left my help with dry, cracked skin. That stopped completely after we switched.</p>
          <div class="who">{% render 'icon-purelane', icon: 'check-simple' %}<b>Priya</b><span>&middot; Dishwash gel</span></div>
        </article>
        <article class="glass-2 rcard">
          <div class="st">★★★★★</div>
          <h5>Great product, great packaging</h5>
          <p>Very soft on hands with a lovely fragrance, and it feels good to be using far less plastic.</p>
          <div class="who">{% render 'icon-purelane', icon: 'check-simple' %}<b>Sunita</b><span>&middot; Liquid handwash</span></div>
        </article>
        <article class="glass-2 rcard">
          <div class="st">★★★★★</div>
          <h5>Dog friendly</h5>
          <p>We switched because chemical floor cleaners were setting off my dog's allergies. No reactions since.</p>
          <div class="who">{% render 'icon-purelane', icon: 'check-simple' %}<b>Rohit S.</b><span>&middot; Floor cleaner</span></div>
        </article>
      {% endfor %}

      {% comment %} Duplicated Loop for Seamless Continuous Marquee Effect {% endcomment %}
      {% for block in section.blocks %}
        {% render 'card-review-purelane', block: block %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane Reviews Rail",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Section Kicker",
      "default": "That's what they said"
    },
    {
      "type": "text",
      "id": "rating_score",
      "label": "Average Rating Score",
      "default": "4.8"
    },
    {
      "type": "text",
      "id": "rating_count",
      "label": "Total Reviews Count",
      "default": "8,000+"
    },
    {
      "type": "text",
      "id": "homes_count",
      "label": "Satisfied Homes Count",
      "default": "12 lakh+"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Customer Review",
      "settings": [
        {
          "type": "text",
          "id": "headline",
          "label": "Review Headline",
          "default": "Works like a charm"
        },
        {
          "type": "textarea",
          "id": "review_body",
          "label": "Review Content",
          "default": "Finally an eco option that cleans as well as the chemical detergent I used for years, and it smells better."
        },
        {
          "type": "text",
          "id": "author_name",
          "label": "Author Name",
          "default": "Anita"
        },
        {
          "type": "text",
          "id": "product_purchased",
          "label": "Product Purchased Tag",
          "default": "Laundry detergent"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Reviews Rail",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "headline": "Works like a charm",
            "review_body": "Finally an eco option that cleans as well as the chemical detergent I used for years, and it smells better.",
            "author_name": "Anita",
            "product_purchased": "Laundry detergent"
          }
        },
        {
          "type": "review",
          "settings": {
            "headline": "Best dishwash ever",
            "review_body": "Our old dishwash left my help with dry, cracked skin. That stopped completely after we switched.",
            "author_name": "Priya",
            "product_purchased": "Dishwash gel"
          }
        },
        {
          "type": "review",
          "settings": {
            "headline": "Great product, great packaging",
            "review_body": "Very soft on hands with a lovely fragrance, and it feels good to be using far less plastic.",
            "author_name": "Sunita",
            "product_purchased": "Liquid handwash"
          }
        },
        {
          "type": "review",
          "settings": {
            "headline": "Dog friendly",
            "review_body": "We switched because chemical floor cleaners were setting off my dog's allergies. No reactions since.",
            "author_name": "Rohit S.",
            "product_purchased": "Floor cleaner"
          }
        }
      ]
    }
  ]
}
{% endschema %}
