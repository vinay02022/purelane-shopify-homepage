<section class="sec" id="combos" data-scene="3">
  <div class="wrap">
    <div class="panel-head rv">
      {% if section.settings.kicker != blank %}
        <span class="kicker">{{ section.settings.kicker }}</span>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="d2" style="margin-top:12px">{{ section.settings.heading }}</h2>
      {% endif %}

      <div class="rule">
        <i></i>
        {% render 'icon-purelane', icon: 'leaf' %}
        <i></i>
      </div>

      {% if section.settings.description != blank %}
        <p class="lede" style="margin:14px auto 0">
          {{ section.settings.description }}
        </p>
      {% endif %}
    </div>

    <div class="comborail rv">
      {% for block in section.blocks %}
        {% render 'card-combo-purelane', block: block %}
      {% else %}
        {% comment %} Render sample cards if no blocks added yet {% endcomment %}
        <div class="glass combo hero-combo">
          <div class="tray">
            <span class="save">You save ₹398</span>
            <span class="flag">Most popular</span>
            <div class="stack">
              <span class="it"><span class="tile">{% render 'icon-purelane', icon: 'leaf' %}</span><span>Cuts grease</span></span>
              <span class="plus">+</span>
              <span class="it"><span class="tile">{% render 'icon-purelane', icon: 'leaf' %}</span><span>Dishes</span></span>
              <span class="plus">+</span>
              <span class="it"><span class="tile">{% render 'icon-purelane', icon: 'leaf' %}</span><span>Tap cleaner</span></span>
            </div>
          </div>
          <div class="body">
            <h3>Kitchen essentials</h3>
            <div class="cnt">3 products</div>
            <p class="inc">Includes: Foaming Kitchen Cleaner, Dishwash Gel & Tap Cleaner.</p>
            <div class="prow"><strong>₹499</strong><s>₹897</s><em>Save ₹398</em></div>
            <div class="fine">Inclusive of all taxes &middot; COD available</div>
            <a class="btn btn-ghost" href="#bundles">Shop bundle {% render 'icon-purelane', icon: 'arrow-right' %}</a>
          </div>
        </div>
      {% endfor %}
    </div>

    <div class="swipecue" aria-hidden="true">
      {% render 'icon-purelane', icon: 'arrow-right' %}
      Swipe for more combos
    </div>

    {% if section.settings.rail_note != blank %}
      <p class="railnote">
        {{ section.settings.rail_note }}
      </p>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Purelane Combos Rail",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Section Kicker",
      "default": "Pre-built to save you money"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Best selling combos"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Lede Description",
      "default": "Swipe through the boxes people order most. Each one is already priced below buying the same products on their own."
    },
    {
      "type": "text",
      "id": "rail_note",
      "label": "Bottom Rail Note",
      "default": "Tapping \"Shop bundle\" opens the bundle picker with these products already added. You can still swap anything before you pay."
    }
  ],
  "blocks": [
    {
      "type": "combo_card",
      "name": "Combo Card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Combo Title",
          "default": "Kitchen essentials"
        },
        {
          "type": "text",
          "id": "item_count",
          "label": "Item Count Subheading",
          "default": "3 products"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Includes: Foaming Kitchen Cleaner, Dishwash Gel & Tap Cleaner. Everything for a sparkling kitchen, no need to pick separately."
        },
        {
          "type": "checkbox",
          "id": "is_popular",
          "label": "Highlight as Most Popular",
          "default": true
        },
        {
          "type": "text",
          "id": "save_text",
          "label": "Save Callout Text",
          "default": "₹398"
        },
        {
          "type": "text",
          "id": "flag_text",
          "label": "Flag Tag Text",
          "default": "Most popular"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Combo Price",
          "default": "₹499"
        },
        {
          "type": "text",
          "id": "compare_at_price",
          "label": "Compare Price",
          "default": "₹897"
        },
        {
          "type": "product",
          "id": "product_1",
          "label": "Product 1"
        },
        {
          "type": "text",
          "id": "p1_note",
          "label": "Product 1 Subnote",
          "default": "Cuts grease instantly"
        },
        {
          "type": "product",
          "id": "product_2",
          "label": "Product 2"
        },
        {
          "type": "text",
          "id": "p2_note",
          "label": "Product 2 Subnote",
          "default": "Squeaky clean dishes"
        },
        {
          "type": "product",
          "id": "product_3",
          "label": "Product 3"
        },
        {
          "type": "text",
          "id": "p3_note",
          "label": "Product 3 Subnote",
          "default": "Melts hard water stains"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button Text",
          "default": "Shop bundle"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "Button Link",
          "default": "/#bundles"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Combos Rail",
      "blocks": [
        {
          "type": "combo_card",
          "settings": {
            "title": "Kitchen essentials",
            "item_count": "3 products",
            "is_popular": true,
            "save_text": "₹398",
            "flag_text": "Most popular",
            "price": "₹499",
            "compare_at_price": "₹897",
            "p1_note": "Cuts grease instantly",
            "p2_note": "Squeaky clean dishes",
            "p3_note": "Melts hard water stains"
          }
        },
        {
          "type": "combo_card",
          "settings": {
            "title": "Laundry & Freshness",
            "item_count": "2 products",
            "is_popular": false,
            "save_text": "₹249",
            "flag_text": "",
            "price": "₹349",
            "compare_at_price": "₹598",
            "p1_note": "Removes tough stains",
            "p2_note": "Softens fabric"
          }
        }
      ]
    }
  ]
}
{% endschema %}
